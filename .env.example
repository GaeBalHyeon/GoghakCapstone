# Windows server
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ev_fire_guard
MYSQL_USER=evguard
MYSQL_PASSWORD=change-this-password

# Jetson과 Windows 서버가 함께 사용할 임의의 긴 문자열
EDGE_TOKEN=change-this-edge-token

# Telegram mobile alerts (run configure_telegram.bat instead of editing secrets here)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_ATTEMPTS=3
DASHBOARD_URL=http://127.0.0.1:8000

